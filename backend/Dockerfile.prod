FROM node:26-alpine AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++ tesseract-ocr openssl sane

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx prisma generate
RUN npm run build && test -f dist/main.js || (echo "ERROR: dist/main.js not produced by build" && exit 1)
# Compile seed separately (tsconfig excludes prisma/ so nest build skips it).
# --rootDir . is required: without it tsc infers rootDir=prisma/ and rejects the
# import '../src/generated/prisma/client' (TS6059 — above rootDir). With rootDir=.
# and outDir=dist the output lands at dist/prisma/seed.js (matching the CMD below).
RUN npx tsc --skipLibCheck --esModuleInterop --allowSyntheticDefaultImports \
    --target ES2021 --module commonjs --moduleResolution node --rootDir . --outDir dist \
    prisma/seed.ts 2>/dev/null || true
# seed.js requires('../src/generated/prisma/client') at runtime. The Nest build
# compiles src/generated/prisma/ → dist/generated/prisma/ (strips the src/ prefix).
# Mirror it to dist/src/generated/ so the require resolves correctly:
RUN mkdir -p dist/src && cp -r dist/generated dist/src/

# ---- runtime ----
FROM node:26-alpine

WORKDIR /app

RUN apk add --no-cache tesseract-ocr openssl sane

COPY package*.json ./
RUN npm install --omit=dev --legacy-peer-deps

# Copy compiled output from builder. In Prisma 7 the client is generated as
# TypeScript under src/generated/prisma and compiled into dist/generated/prisma,
# so it travels inside ./dist — no separate node_modules/.prisma or
# @prisma/client copy is needed (the prod `npm install` above provides the
# @prisma/client runtime and @prisma/adapter-pg packages).
COPY --from=builder /app/dist ./dist
COPY prisma ./prisma
COPY scripts ./scripts
COPY prisma.config.ts ./prisma.config.ts

EXPOSE 4000

# Boot chain — every step echoes a marker so a deploy-log break in the middle
# tells us exactly which step failed.
#
#   1. Run scripts/migrate.js — validates all migrations, auto-resolves any
#      that failed mid-run (Prisma P3009), then applies all pending ones.
#   2. Optionally seed demo users + reference data AND default job setups /
#      lookup sources (gated by RUN_SEED=true). Both seeds are idempotent
#      (upsert / upsert-by-slug) but shouldn't run on every restart in prod:
#      the user seed re-applies demo passwords and writes to the audit trail.
#      Set RUN_SEED=true once for a fresh DB, then unset.
#   3. Hand off to the API server.
#
# `exec` on the last line replaces the shell process with node, so signals
# from the orchestrator reach the app cleanly (no zombie wrapper).
CMD set -e \
    && echo "[boot] step 1/3 migrate (validate + auto-recover + deploy)" \
    && node scripts/migrate.js \
    && echo "[boot] step 2/3 seed reference data (RUN_SEED=$RUN_SEED)" \
    && if [ "$RUN_SEED" = "true" ]; then \
         node dist/prisma/seed.js \
         && echo "[boot] step 2/3 seeding job setups + lookup sources" \
         && node prisma/seed-job-setups.js; \
       else echo "[boot] step 2/3 skipped (set RUN_SEED=true to enable)"; fi \
    && echo "[boot] step 3/3 starting API on PORT=$PORT" \
    && exec node dist/main
