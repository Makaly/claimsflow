{
  "compilerOptions": {
    "composite": true,
    // `tsc -b` requires a referenced composite project to emit, but we must NOT
    // leave vite.config.js / .d.ts next to the source — Vite resolves
    // vite.config.js before vite.config.ts, so a stale compiled copy would
    // silently shadow the real config. Redirect emit into a throwaway,
    // gitignored dir so the type-check still runs but nothing lands beside it.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
