# Storybook 8.6 and its Vite plugins still declare a peer range of vite <= 6,
# but the app is on Vite 8. The conflict is benign (Storybook builds fine on
# Vite 8 at runtime), so install with legacy peer resolution. Applying it here
# keeps CI, local, and contributor installs consistent without a CI-specific
# override flag. Revisit once Storybook 9 (Vite 8-compatible) is adopted.
legacy-peer-deps=true
