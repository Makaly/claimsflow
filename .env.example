# Root environment file consumed by docker-compose.yml.
# Copy to `.env` (gitignored) and fill in real values before `docker compose up`.
# docker-compose now REFUSES to start if the required secrets below are unset.

# Postgres — pick a strong password; never use the literal "postgres".
POSTGRES_USER=claimsflow
POSTGRES_PASSWORD=        # REQUIRED — e.g. `openssl rand -base64 24`
POSTGRES_DB=cic_claims

# Backend JWT signing secret — REQUIRED. Generate with `openssl rand -hex 64`.
JWT_SECRET=

# Shared secret between the backend and the ML sidecar (X-API-Key) — REQUIRED.
# Generate with `openssl rand -hex 32` and keep it identical on both services.
ML_SIDECAR_API_KEY=
